 	// No dma-buf cache maintenance happens on the vtest path: drop any stale CPU cache lines too.
 	vulkan_venus_clean_cpu_writes( g_output.venusReadbackData, uSize );
 
+	// The frame marker the GPU writes after the copy says whether the wait returned before the
+	// GPU had finished it. If so, poll the marker (up to 100 ms) and drop the cache lines read too
+	// early. BL_VENUS_READBACK_WAIT=0 only measures.
+	static const bool s_bWait = []{ const char *pch = getenv( "BL_VENUS_READBACK_WAIT" ); return !pch || env_to_bool( pch ); }();
+	static uint64_t s_ulWindowStart = 0;
+	static uint32_t s_uFrames = 0, s_uEarly = 0, s_uTimeouts = 0, s_uSummaries = 0;
