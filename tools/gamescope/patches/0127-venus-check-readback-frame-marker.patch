+			while ( uSeen != uExpected && ulWaited < 100'000'000ull )
+			{
+				usleep( 100 );
+				vulkan_venus_clean_cpu_writes( (const void *)pMarker, sizeof( *pMarker ) );
+				uSeen = *pMarker;
+				ulWaited = get_time_in_nanos() - ulStart;
+			}
+			s_ulWorstWait = std::max( s_ulWorstWait, ulWaited );
+			if ( uSeen != uExpected )
+				s_uTimeouts++;
+			vulkan_venus_clean_cpu_writes( g_output.venusReadbackData, uSize );
+		}
+	}
+
+	const uint64_t ulNow = get_time_in_nanos();
+	if ( !s_ulWindowStart )
+		s_ulWindowStart = ulNow;
+	if ( ulNow - s_ulWindowStart >= 5'000'000'000ull )
+	{
+		if ( s_uEarly || s_uSummaries < 3 )
+		{
+			s_uSummaries++;
+			vk_log.infof( "Venus readback: %u of %u frames read before the GPU finished them (worst %d frames behind%s, longest extra wait %.1f ms, %u timeouts)",
+				s_uEarly, s_uFrames, s_nWorstLag, s_bWait ? "" : ", measuring only", s_ulWorstWait / 1e6, s_uTimeouts );
+		}
+		s_ulWindowStart = ulNow;
+		s_uFrames = s_uEarly = s_uTimeouts = 0;
+		s_nWorstLag = 0;
+		s_ulWorstWait = 0;
+	}
+
 	*pWidth = uWidth;
 	*pHeight = uHeight;
