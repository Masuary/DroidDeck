+    // Venus shm output: three wl_shm buffers that carry the read-back composite. The host
+    // compositor copies a wl_shm frame when it is committed, so the GPU sharing that returns stale
+    // dma-buf contents on PowerVR is never involved.
+    struct VenusShmBuffer
+    {
+        wl_buffer *pBuffer = nullptr;
+        void *pData = nullptr;
+        size_t uSize = 0;
+        uint32_t uWidth = 0;
+        uint32_t uHeight = 0;
+        bool bBusy = false;
+    };
+    static VenusShmBuffer s_VenusShm[ 3 ];
+
+    static void VenusShmRelease( void *pData, wl_buffer * )
+    {
+        static_cast<VenusShmBuffer *>( pData )->bBusy = false;
+    }
+    static const wl_buffer_listener s_VenusShmListener = { .release = VenusShmRelease };
+
+    static void VenusShmDestroy( VenusShmBuffer &buf )
+    {
+        if ( buf.pBuffer )
+            wl_buffer_destroy( buf.pBuffer );
+        if ( buf.pData )
+            munmap( buf.pData, buf.uSize );
+        buf = VenusShmBuffer{};
+    }
+
+    // A buffer the compositor has released, (re)made at this size; waits up to 50 ms for one.
+    static VenusShmBuffer *VenusShmAcquire( CWaylandBackend *pBackend, uint32_t uWidth, uint32_t uHeight )
+    {
+        const uint64_t ulDeadline = get_time_in_nanos() + 50'000'000ul;
+        for ( ;; )
+        {
+            for ( VenusShmBuffer &buf : s_VenusShm )
+            {
+                if ( buf.bBusy )
+                    continue;
+                if ( buf.pBuffer && buf.uWidth == uWidth && buf.uHeight == uHeight )
+                    return &buf;
+                VenusShmDestroy( buf );
+                const size_t uSize = size_t( uWidth ) * uHeight * 4;
+                int nFd = CreateShmBuffer( uint32_t( uSize ), nullptr );
+                if ( nFd < 0 )
+                    return nullptr;
+                void *pData = mmap( nullptr, uSize, PROT_READ | PROT_WRITE, MAP_SHARED, nFd, 0 );
+                if ( pData == MAP_FAILED )
+                {
+                    close( nFd );
+                    return nullptr;
+                }
+                wl_shm_pool *pPool = wl_shm_create_pool( pBackend->GetShm(), nFd, int32_t( uSize ) );
+                buf.pBuffer = wl_shm_pool_create_buffer( pPool, 0, int32_t( uWidth ), int32_t( uHeight ), int32_t( uWidth * 4 ), WL_SHM_FORMAT_XRGB8888 );
+                wl_shm_pool_destroy( pPool );
+                close( nFd );
+                buf.pData = pData;
+                buf.uSize = uSize;
+                buf.uWidth = uWidth;
+                buf.uHeight = uHeight;
+                wl_buffer_add_listener( buf.pBuffer, &s_VenusShmListener, &buf );
+                return &buf;
+            }
+
+            const uint64_t ulNow = get_time_in_nanos();
+            if ( ulNow >= ulDeadline )
+                return nullptr;
+            wl_display *pDisplay = pBackend->GetDisplay();
+            wl_display_flush( pDisplay );
+            if ( wl_display_prepare_read( pDisplay ) == 0 )
+            {
+                pollfd pollfd = { .fd = wl_display_get_fd( pDisplay ), .events = POLLIN };
+                int nRet;
+                do
+                {
+                    nRet = poll( &pollfd, 1, int( std::max<uint64_t>( 1, ( ulDeadline - ulNow ) / 1'000'000ul ) ) );
+                } while ( nRet < 0 && ( errno == EINTR || errno == EAGAIN ) );
+                if ( nRet > 0 )
+                    wl_display_read_events( pDisplay );
+                else
+                    wl_display_cancel_read( pDisplay );
+            }
+            wl_display_dispatch_pending( pDisplay );
+        }
+    }
