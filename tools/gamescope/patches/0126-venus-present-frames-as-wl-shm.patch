+const void *vulkan_venus_readback( uint32_t *pWidth, uint32_t *pHeight )
+{
+	if ( !g_output.venusReadbackData || g_output.outputImages.empty() )
+		return nullptr;
+
+	const uint32_t uWidth = g_output.outputImages[ 0 ]->width();
+	const uint32_t uHeight = g_output.outputImages[ 0 ]->height();
+	const size_t uSize = size_t( uWidth ) * uHeight * 4;
+	if ( uSize > g_output.venusReadbackSize )
+		return nullptr;
+
+	VkMappedMemoryRange range = {
+		.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE,
+		.memory = g_output.venusReadbackMemory,
+		.offset = 0,
+		.size = VK_WHOLE_SIZE,
+	};
+	g_device.vk.InvalidateMappedMemoryRanges( g_device.device(), 1, &range );
+	// No dma-buf cache maintenance happens on the vtest path: drop any stale CPU cache lines too.
+	vulkan_venus_clean_cpu_writes( g_output.venusReadbackData, uSize );
+
+	*pWidth = uWidth;
+	*pHeight = uHeight;
+	return g_output.venusReadbackData;
+}
