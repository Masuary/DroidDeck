+void CVulkanCmdBuffer::copyImageToBuffer(gamescope::Rc<CVulkanTexture> src, VkBuffer buffer)
+{
+	prepareSrcImage(src.get());
+	insertBarrier();
+
+	VkBufferImageCopy region = {
+		.imageSubresource = { .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT, .layerCount = 1 },
+		.imageExtent = { src->width(), src->height(), 1 },
+	};
+	m_device->vk.CmdCopyImageToBuffer(m_cmdBuffer, src->vkImage(), VK_IMAGE_LAYOUT_GENERAL, buffer, 1, &region);
+
+	// The host reads the buffer after the submission's wait.
+	VkBufferMemoryBarrier toHost = {
+		.sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER,
+		.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+		.dstAccessMask = VK_ACCESS_HOST_READ_BIT,
+		.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+		.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+		.buffer = buffer,
+		.offset = 0,
+		.size = VK_WHOLE_SIZE,
+	};
+	m_device->vk.CmdPipelineBarrier(m_cmdBuffer, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT,
+		0, 0, nullptr, 1, &toHost, 0, nullptr);
+
+	m_textureRefs.emplace_back(std::move(src));
+}
