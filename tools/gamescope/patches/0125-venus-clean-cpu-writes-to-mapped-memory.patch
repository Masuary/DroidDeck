--- a/src/rendervulkan.cpp
+++ b/src/rendervulkan.cpp
@@ -330,6 +330,41 @@ bool CVulkanDevice::BInit(VkInstance instance, VkSurfaceKHR surface)
 
 extern bool env_to_bool(const char *env);
 
+// Venus (BL_VENUS=1, the Pixel/PowerVR port): host-visible memory is the vendor driver's dma-buf,
+// mapped into this process by the Venus ICD, and the GPU does not snoop the CPU caches for it.
+// Nothing in the vtest path performs dma-buf cache maintenance, so what the CPU writes can sit in
+// the cache while the GPU reads whatever the pages held before: Steam's window, uploaded from
+// Xwayland's shm every frame, came out as older frames and other sessions' leftovers. Clean the
+// written range to the point of coherency before the GPU reads it. EL0 may do this on Linux
+// (SCTLR_EL1.UCI); CTR_EL0 gives the smallest data cache line.
+void vulkan_venus_clean_cpu_writes( const void *pData, size_t uSize )
+{
+#if defined(__aarch64__)
+	static const bool s_bVenus = env_to_bool( getenv( "BL_VENUS" ) );
+	if ( !s_bVenus || !pData || !uSize )
+		return;
+
+	uint64_t ulCtr;
+	asm volatile( "mrs %0, ctr_el0" : "=r"( ulCtr ) );
+	const uintptr_t uLine = uintptr_t( 4 ) << ( ( ulCtr >> 16 ) & 0xf );
+
+	static bool s_bSaid = false;
+	if ( !s_bSaid )
+	{
+		s_bSaid = true;
+		vk_log.infof( "Venus: cleaning CPU writes to mapped memory to the point of coherency (%zu-byte lines)", (size_t)uLine );
+	}
+
+	const uintptr_t uEnd = uintptr_t( pData ) + uSize;
+	for ( uintptr_t p = uintptr_t( pData ) & ~( uLine - 1 ); p < uEnd; p += uLine )
+		asm volatile( "dc civac, %0" :: "r"( p ) : "memory" );
+	asm volatile( "dsb sy" ::: "memory" );
+#else
+	(void)pData;
+	(void)uSize;
+#endif
+}
