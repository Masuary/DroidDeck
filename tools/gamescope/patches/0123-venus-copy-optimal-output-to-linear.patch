+	outputImageflags.bStorage = !bVenusCopy;
+	outputImageflags.bTransferDst = bVenusCopy;
+	outputImageflags.bLinear = bVenusCopy;
 	outputImageflags.bTransferSrc = true; // for screenshots
 	outputImageflags.bSampled = true; // for pipewire blits
 	outputImageflags.bOutputImage = true;
@@ -3438,10 +3446,25 @@
 		return false;
 	}
 
+	if ( bVenusCopy )
+	{
+		CVulkanTexture::createFlags renderFlags;
+		renderFlags.bStorage = true;
+		renderFlags.bSampled = true;
+		renderFlags.bTransferSrc = true;
+		pOutput->venusCompositeImage = new CVulkanTexture();
