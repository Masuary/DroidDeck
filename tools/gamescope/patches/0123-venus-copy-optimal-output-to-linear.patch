 	}
@@ -4398,6 +4423,20 @@
 	else
 		compositeImage = partial ? g_output.outputImagesPartialOverlay[ g_output.nOutImage ] : g_output.outputImages[ g_output.nOutImage ];
 
+	gamescope::Rc<CVulkanTexture> sharedOutputImage;
+	if ( !pOutputOverride && g_output.venusCompositeImage )
+	{
+		// This path is only used by a nested modifier backend, which composites
+		// the entire frame. The exported image is never bound as a storage target.
+		if ( partial )
+		{
+			vk_log.errorf( "partial composition is unavailable for Venus copy output" );
+			return std::nullopt;
+		}
+		sharedOutputImage = compositeImage;
+		compositeImage = g_output.venusCompositeImage;
+	}
+
 	// Overrides (screenshots, upscale cache) are logical-sized, so never rotated.
 	const uint32_t uOutputRotation = pOutputOverride ? 0u : g_uOutputRotation;
 
