+    // Venus (BL_VENUS=1, the Pixel/PowerVR port): the host compositor can only show
+    // gamescope's own composited output. Steam can set GAMESCOPE_COMPOSITE_FORCE to 0, which
+    // overrides --force-composition; without composition the planes carry client textures
+    // and a black backing buffer, which did not get the Venus output copy (0123).
+    static bool VenusSession()
+    {
+        static const bool s_bVenus = env_to_bool( getenv( "BL_VENUS" ) );
+        return s_bVenus;
+    }
+
+    // Output images rotate without regard to wl_buffer.release. A host compositor that
+    // presents more slowly than gamescope composites can still be reading the image the
+    // next frame would overwrite. Wait a bounded time for its release before writing it.
+    static void WaitForOutputImageRelease( wl_display *pDisplay )
+    {
+        gamescope::Rc<CVulkanTexture> pNext = vulkan_get_next_output_image();
+        if ( pNext == nullptr || pNext->GetBackendFb() == nullptr )
+            return;
+
+        // Same lookup as CWaylandPlane::Present: the image was imported when it was last presented.
+        CWaylandFb *pFb = static_cast<CWaylandFb *>( pNext->GetBackendFb()->EnsureImported() );
+        if ( !pFb || !pFb->IsCompositorAcquired() )
+            return;
+
+        static uint64_t s_ulWaits = 0;
+        static uint64_t s_ulTimeouts = 0;
+        const uint64_t ulStart = get_time_in_nanos();
+        const uint64_t ulDeadline = ulStart + 100'000'000ul;
+
+        wl_display_flush( pDisplay );
+        while ( pFb->IsCompositorAcquired() )
+        {
+            const uint64_t ulNow = get_time_in_nanos();
+            if ( ulNow >= ulDeadline )
+                break;
+
+            if ( wl_display_prepare_read( pDisplay ) != 0 )
+            {
+                wl_display_dispatch_pending( pDisplay );
+                continue;
+            }
+
+            pollfd pollfd =
+            {
+                .fd     = wl_display_get_fd( pDisplay ),
+                .events = POLLIN,
+            };
+            int nTimeoutMs = int( std::max<uint64_t>( 1, ( ulDeadline - ulNow ) / 1'000'000ul ) );
+            int nRet;
+            do
+            {
+                nRet = poll( &pollfd, 1, nTimeoutMs );
+            } while ( nRet < 0 && ( errno == EINTR || errno == EAGAIN ) );
+
+            if ( nRet > 0 )
+                wl_display_read_events( pDisplay );
+            else
+                wl_display_cancel_read( pDisplay );
+            wl_display_dispatch_pending( pDisplay );
+        }
+
+        s_ulWaits++;
+        const bool bTimedOut = pFb->IsCompositorAcquired();
+        if ( bTimedOut )
+            s_ulTimeouts++;
+        // First occurrence, then every 300th, so the session log shows how often it happens.
+        if ( s_ulWaits == 1 || ( bTimedOut && s_ulTimeouts == 1 ) || s_ulWaits % 300 == 0 )
+            xdg_log.infof( "Venus: next output image still held by the host compositor; waited %.1f ms (%s, %lu waits, %lu timeouts)",
+                ( get_time_in_nanos() - ulStart ) / 1'000'000.0, bTimedOut ? "timed out, overwriting" : "released",
+                (unsigned long)s_ulWaits, (unsigned long)s_ulTimeouts );
+    }
