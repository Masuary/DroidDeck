+uint64_t CVulkanDevice::gpuSeqNo( uint64_t ulSemaphoreValue )
+{
+	if ( !m_pSeqMarker )
+		return ulSemaphoreValue;
+	vulkan_venus_clean_cpu_writes( (const void *)m_pSeqMarker, k_uSeqMarkerSlots * sizeof( uint32_t ) );
+	// Advance over the submissions whose slots hold their own number. A later number in the slot
+	// (written 64 submissions on) also counts: with at most 8 in flight, this one is long done.
+	while ( m_ulGpuSeqNo < ulSemaphoreValue &&
+		int32_t( m_pSeqMarker[ ( m_ulGpuSeqNo + 1 ) % k_uSeqMarkerSlots ] - uint32_t( m_ulGpuSeqNo + 1 ) ) >= 0 )
+		m_ulGpuSeqNo++;
+	return std::min( m_ulGpuSeqNo, ulSemaphoreValue );
+}
+
+void CVulkanDevice::waitForGpuSeqNo( uint64_t ulSeqNo )
+{
+	if ( !m_pSeqMarker )
+		return;
+
+	static uint64_t s_ulWindowStart = 0;
+	static uint32_t s_uWaits = 0, s_uLate = 0, s_uTimeouts = 0, s_uSummaries = 0;
+	static uint64_t s_ulWorstWait = 0;
+
+	s_uWaits++;
+	if ( gpuSeqNo( ulSeqNo ) < ulSeqNo )
+	{
+		s_uLate++;
+		const uint64_t ulStart = get_time_in_nanos();
+		uint64_t ulWaited = 0;
+		while ( gpuSeqNo( ulSeqNo ) < ulSeqNo && ulWaited < 1'000'000'000ull )
+		{
+			usleep( 100 );
+			ulWaited = get_time_in_nanos() - ulStart;
+		}
+		s_ulWorstWait = std::max( s_ulWorstWait, ulWaited );
+		if ( gpuSeqNo( ulSeqNo ) < ulSeqNo )
+			s_uTimeouts++;
+	}
+
+	const uint64_t ulNow = get_time_in_nanos();
+	if ( !s_ulWindowStart )
+		s_ulWindowStart = ulNow;
+	if ( ulNow - s_ulWindowStart >= 5'000'000'000ull )
+	{
+		if ( s_uLate || s_uSummaries < 3 )
+		{
+			s_uSummaries++;
+			vk_log.infof( "Venus: %u of %u waits returned before the GPU finished (longest extra wait %.1f ms, %u timeouts after 1 s)",
+				s_uLate, s_uWaits, s_ulWorstWait / 1e6, s_uTimeouts );
+		}
+		s_ulWindowStart = ulNow;
+		s_uWaits = s_uLate = s_uTimeouts = 0;
+		s_ulWorstWait = 0;
+	}
 }
 
