+		VkMemoryRequirements markerReq = {};
+		void *pMarker = nullptr;
+		bool bOk = vk.CreateBuffer( device(), &markerInfo, nullptr, &m_seqMarkerBuffer ) == VK_SUCCESS;
+		if ( bOk )
+		{
+			vk.GetBufferMemoryRequirements( device(), m_seqMarkerBuffer, &markerReq );
+			int32_t nType = findMemoryType( VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, markerReq.memoryTypeBits );
+			VkMemoryAllocateInfo markerAlloc = {
+				.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+				.allocationSize = markerReq.size,
+				.memoryTypeIndex = uint32_t( nType ),
+			};
+			bOk = nType >= 0 &&
+				vk.AllocateMemory( device(), &markerAlloc, nullptr, &m_seqMarkerMemory ) == VK_SUCCESS &&
+				vk.BindBufferMemory( device(), m_seqMarkerBuffer, m_seqMarkerMemory, 0 ) == VK_SUCCESS &&
+				vk.MapMemory( device(), m_seqMarkerMemory, 0, VK_WHOLE_SIZE, 0, &pMarker ) == VK_SUCCESS;
+		}
+		if ( bOk )
+		{
+			m_pSeqMarker = (volatile uint32_t *)pMarker;
+			for ( uint32_t i = 0; i < k_uSeqMarkerSlots; i++ )
+				m_pSeqMarker[ i ] = 0;
+			vulkan_venus_clean_cpu_writes( pMarker, k_uSeqMarkerSlots * sizeof( uint32_t ) );
+			vk_log.infof( "Venus: waits confirm each submission through a GPU-written sequence marker (BL_VENUS_SEQ_MARKER=0 to trust the timeline alone)" );
+		}
+		else
+		{
+			vk_log.errorf( "Venus: could not set up the sequence marker; waits trust the timeline alone" );
+			if ( m_seqMarkerMemory )
+				vk.FreeMemory( device(), m_seqMarkerMemory, nullptr );
+			if ( m_seqMarkerBuffer )
+				vk.DestroyBuffer( device(), m_seqMarkerBuffer, nullptr );
+			m_seqMarkerMemory = VK_NULL_HANDLE;
+			m_seqMarkerBuffer = VK_NULL_HANDLE;
+		}
+	}
