+static bool
+vkr_fd_is_dma_buf(int fd, uint64_t blob_size)
+{
+   char path[32];
+   char target[16] = "";
+   snprintf(path, sizeof(path), "/proc/self/fd/%d", fd);
+   const ssize_t len = readlink(path, target, sizeof(target) - 1);
+   if (len < (ssize_t)strlen("/dmabuf:") || strncmp(target, "/dmabuf:", strlen("/dmabuf:")))
+      return false;
+   const off_t size = lseek(fd, 0, SEEK_END);
+   lseek(fd, 0, SEEK_SET);
+   return size >= 0 && (uint64_t)size >= blob_size;
+}
